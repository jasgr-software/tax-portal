{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Agent",
      "Skill",
      "EnterPlanMode",
      "ExitPlanMode",
      "WebSearch",
      "WebFetch",
      "Write(docs/**)",
      "Write(agents/**)",
      "Write(CLAUDE.md)",
      "Edit(docs/**)",
      "Edit(agents/**)",
      "Edit(CLAUDE.md)",
      "Write(apps/**)",
      "Write(packages/**)",
      "Write(prisma/**)",
      "Write(supabase/**)",
      "Write(infra/**)",
      "Write(.github/**)",
      "Write(.env.example)",
      "Write(docker-compose.yml)",
      "Write(Dockerfile*)",
      "Write(scripts/**)",
      "Edit(apps/**)",
      "Edit(packages/**)",
      "Edit(prisma/**)",
      "Edit(supabase/**)",
      "Edit(infra/**)",
      "Edit(.github/**)",
      "Edit(.env.example)",
      "Edit(docker-compose.yml)",
      "Edit(Dockerfile*)",
      "Edit(scripts/**)",
      "Bash(git:*)",
      "Bash(pnpm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(docker:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(diff:*)",
      "Bash(which:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Write(/tmp/**)",
      "Edit(/tmp/**)",
      "Bash(*>/tmp/*)",
      "Bash(*>>/tmp/*)",
      "Bash(* /tmp/*)",
      "Bash(bash:*)",
      "Bash(curl:*)",
      "Bash(kill:*)",
      "Bash(python3:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run watch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh workflow view:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh auth status)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(rm -rf /home*)",
      "Bash(rm -rf /*)"
    ]
  },
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/log-dispatch.py 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/log-task-edit.py 2>/dev/null || true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|Read|Glob|Grep|NotebookEdit|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/log-tool-error.py 2>/dev/null || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/log-tool-call.py 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/log-notification.py 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/log-stop.py 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/log-session.py session_start 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/log-session.py session_end 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
