{
  "name": "admin",
  "version": "0.0.1",
  "private": true,
  "description": "Tax Portal — accountant-facing Next.js 15 App Router app (ADR-006)",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "sh -c 'next build'",
    "start": "next start -p 3001",
    "lint": "sh -c 'eslint src --max-warnings 0'",
    "type-check": "sh -c 'tsc --noEmit'",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:run": "playwright test --grep-invert @demo",
    "e2e:smoke": "playwright test --grep @smoke --grep-invert @demo",
    "e2e:demo": "playwright test --grep @demo"
  },
  "dependencies": {
    "@tax-portal/auth": "workspace:*",
    "@tax-portal/db": "workspace:*",
    "@tax-portal/ui": "workspace:*",
    "next": "15.5.19",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tax-portal/eslint-config": "workspace:*",
    "@tax-portal/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
