# ============================================================
# Tax Portal — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real secrets.
# ============================================================

# ------ Database (ADR-002 / ADR-003 / TASK-006) -----------
# Two connection pools per ADR-003 §1: one low-privilege request pool
# and one elevated admin pool. Both use the sqlserver:// scheme.
#
# URL FORM (required — all four components):
#   sqlserver://HOST;port=PORT;database=DB;user=USER;password=PASS;trustServerCertificate=true
#
# HOST is the SQL Server host:
#   - Inside Docker containers (portal service): use the compose service name "sqlserver"
#   - From the host (Playwright e2e fixtures, local dev server, pnpm db:migrate, pnpm db:seed):
#     use "localhost" with port SQLSERVER_PORT (default 14330 — the host-side port mapping)
#
# IMPORTANT: The host-side port is 14330 (not 1433). docker-compose.yml maps
# SQLSERVER_PORT (default 14330) → container port 1433. The Playwright e2e fixture
# (apps/portal/e2e/fixtures/db.ts) runs on the HOST and must use localhost:14330.
# Scripts (db:migrate, db:seed) also run on the host and need port 14330.
# Only services inside docker-compose use the internal service name "sqlserver" on port 1433.
#
# SQLSERVER_PORT — host-side port mapping for SQL Server (container always uses 1433 internally).
SQLSERVER_PORT=14330

# Request pool — low-privilege principal (taxportal_app login, app_user_role member).
# Used by all request-scoped Prisma queries via the lazy db client. Subject to RLS (ADR-005).
# Construction is lazy (TASK-006 fix-forward): env var is read at first use, not at import time.
#
# HOST-SIDE value (local dev server, Playwright fixture running on host): use localhost:14330.
# Container-side value (if ever needed inside docker-compose): use sqlserver:1433.
DATABASE_URL=sqlserver://localhost;port=14330;database=tax_portal;user=taxportal_app;password=PLACEHOLDER_app_password;trustServerCertificate=true

# Admin pool — elevated principal (taxportal_admin login, app_admin_role member, RLS-exempt).
# Used by pnpm db:migrate (Track A + B), pnpm db:seed, pnpm db:policies:apply, cron, webhooks,
# and the anonymous engagement-request write path (ADR-003 §1/§6).
#
# SEED / MIGRATE PRINCIPAL: pnpm db:migrate and pnpm db:seed MUST run as taxportal_admin
# (app_admin_role member), NOT as sa. The Service RLS BLOCK predicate blocks INSERT from
# sa (which is NOT a member of app_admin_role). Running db:seed as sa will fail with a
# blocked-by-BLOCK-predicate error. See .implementation/operations/runbook.md.
#
# HOST-SIDE value (pnpm db:migrate, pnpm db:seed, Playwright fixture on host): use localhost:14330.
# Container-side value (portal runtime): use sqlserver:1433 (docker-compose internal DNS).
DATABASE_URL_ADMIN=sqlserver://localhost;port=14330;database=tax_portal;user=taxportal_admin;password=PLACEHOLDER_admin_password;trustServerCertificate=true

# SQL Server SA password (local dev Docker container only — never production).
# Must meet SQL Server complexity requirements: >=8 chars, upper + lower + digit + symbol.
# Used only to start the SQL Server container (MSSQL_SA_PASSWORD in docker-compose.yml).
# Application logins (taxportal_admin, taxportal_app) are separate SQL logins created by
# db:migrate with their own passwords (set above in DATABASE_URL_ADMIN / DATABASE_URL).
SA_PASSWORD=PLACEHOLDER_change_me_1!


# ------ Docker-compose container-side DB URLs (TASK-006) ---
# PORTAL_ variants use the Docker compose internal service name 'sqlserver' (port 1433).
# The portal container cannot reach localhost:SQLSERVER_PORT — it uses the compose network.
# These are distinct from DATABASE_URL / DATABASE_URL_ADMIN (which use localhost for host-side access).
#
# Set these in .env.local alongside the host-side DATABASE_URL / DATABASE_URL_ADMIN.

# Admin pool for the portal container (uses taxportal_admin login, app_admin_role member).
PORTAL_DATABASE_URL_ADMIN=sqlserver://sqlserver;port=1433;database=tax_portal;user=taxportal_admin;password=PLACEHOLDER_admin_password;trustServerCertificate=true

# Request pool for the portal container (uses taxportal_app login, app_user_role member).
PORTAL_DATABASE_URL=sqlserver://sqlserver;port=1433;database=tax_portal;user=taxportal_app;password=PLACEHOLDER_app_password;trustServerCertificate=true

# ------ Docker-compose container-side DB URLs for admin (TASK-004-001) ----------
# ADMIN_ variants use the Docker compose internal service name 'sqlserver' (port 1433).
# The admin container cannot reach localhost:SQLSERVER_PORT — it uses the compose network.
# These are distinct from DATABASE_URL / DATABASE_URL_ADMIN (which use localhost for host-side access).
#
# Set these in .env.local alongside the host-side DATABASE_URL / DATABASE_URL_ADMIN.

# Admin pool for the admin container (uses taxportal_admin login, app_admin_role member).
ADMIN_DATABASE_URL_ADMIN=sqlserver://sqlserver;port=1433;database=tax_portal;user=taxportal_admin;password=PLACEHOLDER_admin_password;trustServerCertificate=true

# Request pool for the admin container (uses taxportal_app login, app_user_role member).
ADMIN_DATABASE_URL=sqlserver://sqlserver;port=1433;database=tax_portal;user=taxportal_app;password=PLACEHOLDER_app_password;trustServerCertificate=true

# ------ Azure Blob Storage emulator (Azurite — local dev) --
AZURITE_CONN=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=PLACEHOLDER;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1

# ------ Object Storage (FileStorage port — packages/storage — ADR-008) -------
# These vars are consumed by packages/storage/src/select.ts and must be injected
# into both apps/portal and apps/admin (ADR-006 cross-surface default).
#
# STORAGE_ADAPTER values (ADR-008 § Adapter binding):
#   "azurite"  — AzuriteAdapter: Azurite emulator (local dev + CI default)
#   "memory"   — MemoryAdapter: unit tests only (not for runtime use)
#   "cloud"    — Reserved for Phase-5 production adapter; THROWS at startup in this build
#                (fail-closed boot — no silent fallback to memory or disk, ADR-008)
#   unset      — THROWS at startup (explicit value required)
#
# Local dev default: azurite + the Azurite well-known dev connection string.
STORAGE_ADAPTER=azurite

# Connection string for the AzuriteAdapter (STORAGE_ADAPTER=azurite).
# Azurite well-known dev account (AccountName + AccountKey are public — NOT secret).
# Use the host-side endpoint (127.0.0.1:10000) for the dev server / scripts.
# docker-compose services use the compose service name "azurite" on port 10000 (see below).
#
# The Azurite well-known dev account key (public constant — safe to commit):
STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1

# Blob container name. Default: tax-portal-documents.
# The AzuriteAdapter calls createIfNotExists() on startup — no manual bucket creation needed.
# ADR-008 § Configuration contract: default container name is tax-portal-documents.
STORAGE_CONTAINER=tax-portal-documents

# Docker-compose container-side storage connection strings (portal + admin services):
# Inside docker-compose, the Azurite service is reachable at hostname "azurite" on port 10000.
# Set these in .env.local alongside the host-side STORAGE_CONNECTION_STRING.
PORTAL_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1
ADMIN_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1

# ------ App URLs -------------------------------------------
# Used by Next.js middleware, Clerk redirect URLs, and cross-app links (ADR-010).
PORTAL_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001

# Host-side port for the admin container. Override if port 3001 is taken by another service.
# docker-compose maps ADMIN_PORT (host) → container port 3001.
# Default: 3001. Example if conflicted: ADMIN_PORT=13001
ADMIN_PORT=3001

# Base URL used by Playwright e2e tests and auth fixtures for the admin app.
# Must match http://localhost:ADMIN_PORT. Override in .env.local when ADMIN_PORT != 3001.
# Example: ADMIN_BASE_URL=http://localhost:13001
ADMIN_BASE_URL=http://localhost:3001

# ------ Auth provider (ADR-001 / TASK-004-002) -------------
# "mock" (default) — uses HMAC-signed test sessions; no real Clerk keys required.
#   Use for local dev, e2e, and CI. Set MOCK_SESSION_SECRET to a strong random secret.
#   Also requires ALLOW_MOCK_AUTH=true (see below).
# "clerk" — activates the real Clerk binding (TASK-004-003); requires Clerk keys below.
#   Set to "clerk" only in production or when testing real Clerk flows.
AUTH_PROVIDER=mock

# Mock-auth explicit opt-in (BUG-002-001 fix — ADR-001 auth seam mechanism correction).
# Required when AUTH_PROVIDER=mock so the fail-closed guard in packages/auth permits the
# mock provider to serve requests. The guard keys on this flag (not NODE_ENV) so that
# prod-built containers (where NODE_ENV=production is always true) can still serve the
# mock provider for e2e/local, while a real production deploy (with this unset) throws.
#
# DEV/E2E ONLY — never set in a real deployment.
# A real deployment uses AUTH_PROVIDER=clerk and leaves ALLOW_MOCK_AUTH unset → fail closed.
# Setting AUTH_PROVIDER=clerk alongside ALLOW_MOCK_AUTH=true is a contradiction and will throw.
# The docker-compose.yml portal and admin services set ALLOW_MOCK_AUTH=true for e2e/local.
#
# Uncomment for local dev and e2e (AUTH_PROVIDER=mock only):
# ALLOW_MOCK_AUTH=true

# Signing secret for the mock session cookie (AUTH_PROVIDER=mock only).
# Must be a strong random string in production-like environments.
# NEVER set this in production (AUTH_PROVIDER=clerk in production; mock is not used).
MOCK_SESSION_SECRET=PLACEHOLDER_replace_with_a_strong_random_secret

# ------ Clerk Authentication (ADR-001) --------------------
# Obtain from https://dashboard.clerk.com
# Not required when AUTH_PROVIDER=mock (local dev / e2e / CI).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_PLACEHOLDER
CLERK_SECRET_KEY=sk_test_PLACEHOLDER

# ------ E-sign provider (ADR-023 / ADR-024 / TASK-005-002) -----
# Provider-abstracted e-signature seam (packages/esign).
# ESIGN_PROVIDER values:
#   "docuseal" (default) — DocusealESignatureProvider → self-hosted Docuseal (production, deferred)
#                          Selection completes; stub throws EsignBindingNotAvailableError at call-time
#                          until the real enablement slice lands (ADR-024 §5).
#   "mock"               — MockESignatureProvider → deterministic signed:true (local dev / e2e only)
#                          Requires ALLOW_MOCK_ESIGN=true to be set (fail-closed guard — DECISION-E).
#
# ADR-023 §4 / DECISION-E: default = docuseal (real). The mock requires an explicit opt-in.
# This is the INVERSE default of AUTH_PROVIDER (which defaults to "mock" for historical reasons).
# E-sign is the first seam authored under ADR-023 and sets the correct precedent.
#
# Local dev / e2e: set ESIGN_PROVIDER=mock + ALLOW_MOCK_ESIGN=true
# Production: set ESIGN_PROVIDER=docuseal, leave ALLOW_MOCK_ESIGN unset → fail closed.
# docker-compose.yml portal service defaults to mock/true for e2e/local containers.
ESIGN_PROVIDER=mock

# Mock e-sign explicit opt-in (ADR-023 §4 / DECISION-E — fail-closed guard).
# Required when ESIGN_PROVIDER=mock so the selector permits the mock to serve requests.
# The guard keys on this flag (not NODE_ENV) — same pattern as ALLOW_MOCK_AUTH (BUG-002-001).
#
# DEV/E2E ONLY — NEVER set in a real production deployment.
# A real deployment uses ESIGN_PROVIDER=docuseal and leaves ALLOW_MOCK_ESIGN unset → fail closed.
# Setting ESIGN_PROVIDER=docuseal alongside ALLOW_MOCK_ESIGN=true is a contradiction and will throw.
# The docker-compose.yml portal service sets ALLOW_MOCK_ESIGN=true for e2e/local containers.
#
# Uncomment for local dev and e2e (ESIGN_PROVIDER=mock only):
# ALLOW_MOCK_ESIGN=true

# Self-hosted Docuseal instance (ESIGN_PROVIDER=docuseal — production, deferred ADR-024 §5).
# Not required when ESIGN_PROVIDER=mock (local dev / e2e / CI).
DOCUSEAL_API_URL=http://localhost:3005
DOCUSEAL_API_TOKEN=PLACEHOLDER

# ------ Mail catcher (local dev only) ---------------------
# Mailhog / Inbucket SMTP for local email capture.
# Web UI: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025

# ------ Email transport (REQ-NFR-008 / OQ-002 / TASK-003-002) -----
# Provider-abstracted outbound transactional email seam (packages/email).
# EMAIL_PROVIDER values:
#   "smtp"   (default) — SmtpEmailProvider → Mailhog catcher (local/e2e)
#   "mock"             — MockEmailProvider → in-memory capture (unit tests)
#   "resend"           — ResendEmailProvider → Resend API (production, deferred)
#
# Local dev and e2e: leave as "smtp" (Mailhog on SMTP_HOST:SMTP_PORT above).
# Unit tests: set EMAIL_PROVIDER=mock in the test environment.
# Production: set EMAIL_PROVIDER=resend + RESEND_API_KEY (see below).
EMAIL_PROVIDER=smtp

# Sender address for outbound email (used as the "From:" header).
# Local/e2e: any value works (Mailhog accepts all).
# Production: must be a verified sender domain in your email provider.
EMAIL_FROM=noreply@tax-portal.dev

# Resend API key (production only — EMAIL_PROVIDER=resend).
# Obtain from https://resend.com/api-keys
# Not required when EMAIL_PROVIDER=smtp or EMAIL_PROVIDER=mock.
# RESEND_API_KEY=re_PLACEHOLDER

# ------ Rate limiting (packages/auth InMemoryRateLimiter) -----
# Controls the outbound-email rate limiter (ADR-022 / BUG-003-001).
# These document the production defaults — the limiter falls back to 10/60000 when unset.
#
# Production: leave at defaults (10 attempts per 60s window per rate key).
# docker-compose.yml overrides to 100 for e2e/local dev (prevents exhaustion across sequential
# pnpm e2e:run invocations). You do NOT need to set these here for local dev — the compose
# default of 100 is set in docker-compose.yml for the portal and admin services.
#
# Override if you want to tune the limiter in local dev:
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_WINDOW_MS=60000
