# ============================================================
# Tax Portal — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real secrets.
# ============================================================

# ------ Database (ADR-002 / ADR-003 / TASK-006) -----------
# Two connection pools per ADR-003 §1: one low-privilege request pool
# and one elevated admin pool. Both use the sqlserver:// scheme.
#
# URL FORM (required — all four components):
#   sqlserver://HOST;port=PORT;database=DB;user=USER;password=PASS;trustServerCertificate=true
#
# HOST is the SQL Server host:
#   - Inside Docker containers (portal service): use the compose service name "sqlserver"
#   - From the host (Playwright e2e fixtures, local dev server, pnpm db:migrate, pnpm db:seed):
#     use "localhost" with port SQLSERVER_PORT (default 14330 — the host-side port mapping)
#
# IMPORTANT: The host-side port is 14330 (not 1433). docker-compose.yml maps
# SQLSERVER_PORT (default 14330) → container port 1433. The Playwright e2e fixture
# (apps/portal/e2e/fixtures/db.ts) runs on the HOST and must use localhost:14330.
# Scripts (db:migrate, db:seed) also run on the host and need port 14330.
# Only services inside docker-compose use the internal service name "sqlserver" on port 1433.
#
# SQLSERVER_PORT — host-side port mapping for SQL Server (container always uses 1433 internally).
SQLSERVER_PORT=14330

# Request pool — low-privilege principal (taxportal_app login, app_user_role member).
# Used by all request-scoped Prisma queries via the lazy db client. Subject to RLS (ADR-005).
# Construction is lazy (TASK-006 fix-forward): env var is read at first use, not at import time.
#
# HOST-SIDE value (local dev server, Playwright fixture running on host): use localhost:14330.
# Container-side value (if ever needed inside docker-compose): use sqlserver:1433.
DATABASE_URL=sqlserver://localhost;port=14330;database=tax_portal;user=taxportal_app;password=PLACEHOLDER_app_password;trustServerCertificate=true

# Admin pool — elevated principal (taxportal_admin login, app_admin_role member, RLS-exempt).
# Used by pnpm db:migrate (Track A + B), pnpm db:seed, pnpm db:policies:apply, cron, webhooks,
# and the anonymous engagement-request write path (ADR-003 §1/§6).
#
# SEED / MIGRATE PRINCIPAL: pnpm db:migrate and pnpm db:seed MUST run as taxportal_admin
# (app_admin_role member), NOT as sa. The Service RLS BLOCK predicate blocks INSERT from
# sa (which is NOT a member of app_admin_role). Running db:seed as sa will fail with a
# blocked-by-BLOCK-predicate error. See .implementation/operations/runbook.md.
#
# HOST-SIDE value (pnpm db:migrate, pnpm db:seed, Playwright fixture on host): use localhost:14330.
# Container-side value (portal runtime): use sqlserver:1433 (docker-compose internal DNS).
DATABASE_URL_ADMIN=sqlserver://localhost;port=14330;database=tax_portal;user=taxportal_admin;password=PLACEHOLDER_admin_password;trustServerCertificate=true

# SQL Server SA password (local dev Docker container only — never production).
# Must meet SQL Server complexity requirements: >=8 chars, upper + lower + digit + symbol.
# Used only to start the SQL Server container (MSSQL_SA_PASSWORD in docker-compose.yml).
# Application logins (taxportal_admin, taxportal_app) are separate SQL logins created by
# db:migrate with their own passwords (set above in DATABASE_URL_ADMIN / DATABASE_URL).
SA_PASSWORD=PLACEHOLDER_change_me_1!


# ------ Docker-compose container-side DB URLs (TASK-006) ---
# PORTAL_ variants use the Docker compose internal service name 'sqlserver' (port 1433).
# The portal container cannot reach localhost:SQLSERVER_PORT — it uses the compose network.
# These are distinct from DATABASE_URL / DATABASE_URL_ADMIN (which use localhost for host-side access).
#
# Set these in .env.local alongside the host-side DATABASE_URL / DATABASE_URL_ADMIN.

# Admin pool for the portal container (uses taxportal_admin login, app_admin_role member).
PORTAL_DATABASE_URL_ADMIN=sqlserver://sqlserver;port=1433;database=tax_portal;user=taxportal_admin;password=PLACEHOLDER_admin_password;trustServerCertificate=true

# Request pool for the portal container (uses taxportal_app login, app_user_role member).
PORTAL_DATABASE_URL=sqlserver://sqlserver;port=1433;database=tax_portal;user=taxportal_app;password=PLACEHOLDER_app_password;trustServerCertificate=true

# ------ Docker-compose container-side DB URLs for admin (TASK-004-001) ----------
# ADMIN_ variants use the Docker compose internal service name 'sqlserver' (port 1433).
# The admin container cannot reach localhost:SQLSERVER_PORT — it uses the compose network.
# These are distinct from DATABASE_URL / DATABASE_URL_ADMIN (which use localhost for host-side access).
#
# Set these in .env.local alongside the host-side DATABASE_URL / DATABASE_URL_ADMIN.

# Admin pool for the admin container (uses taxportal_admin login, app_admin_role member).
ADMIN_DATABASE_URL_ADMIN=sqlserver://sqlserver;port=1433;database=tax_portal;user=taxportal_admin;password=PLACEHOLDER_admin_password;trustServerCertificate=true

# Request pool for the admin container (uses taxportal_app login, app_user_role member).
ADMIN_DATABASE_URL=sqlserver://sqlserver;port=1433;database=tax_portal;user=taxportal_app;password=PLACEHOLDER_app_password;trustServerCertificate=true

# ------ Azure Blob Storage emulator (Azurite — local dev) --
AZURITE_CONN=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=PLACEHOLDER;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1

# ------ App URLs -------------------------------------------
# Used by Next.js middleware, Clerk redirect URLs, and cross-app links (ADR-010).
PORTAL_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001

# Host-side port for the admin container. Override if port 3001 is taken by another service.
# docker-compose maps ADMIN_PORT (host) → container port 3001.
# Default: 3001. Example if conflicted: ADMIN_PORT=13001
ADMIN_PORT=3001

# Base URL used by Playwright e2e tests and auth fixtures for the admin app.
# Must match http://localhost:ADMIN_PORT. Override in .env.local when ADMIN_PORT != 3001.
# Example: ADMIN_BASE_URL=http://localhost:13001
ADMIN_BASE_URL=http://localhost:3001

# ------ Auth provider (ADR-001 / TASK-004-002) -------------
# "mock" (default) — uses HMAC-signed test sessions; no real Clerk keys required.
#   Use for local dev, e2e, and CI. Set MOCK_SESSION_SECRET to a strong random secret.
# "clerk" — activates the real Clerk binding (TASK-004-003); requires Clerk keys below.
#   Set to "clerk" only in production or when testing real Clerk flows.
AUTH_PROVIDER=mock

# Signing secret for the mock session cookie (AUTH_PROVIDER=mock only).
# Must be a strong random string in production-like environments.
# NEVER set this in production (AUTH_PROVIDER=clerk in production; mock is not used).
MOCK_SESSION_SECRET=PLACEHOLDER_replace_with_a_strong_random_secret

# ------ Clerk Authentication (ADR-001) --------------------
# Obtain from https://dashboard.clerk.com
# Not required when AUTH_PROVIDER=mock (local dev / e2e / CI).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_PLACEHOLDER
CLERK_SECRET_KEY=sk_test_PLACEHOLDER

# ------ Docuseal (e-sign — ADR reserved) ------------------
# Self-hosted Docuseal instance for engagement letter e-sign.
DOCUSEAL_API_URL=http://localhost:3005
DOCUSEAL_API_TOKEN=PLACEHOLDER

# ------ Mail catcher (local dev only) ---------------------
# Mailhog / Inbucket SMTP for local email capture.
# Web UI: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
